# Copy to .env.local (not committed) and fill in; on Vercel set them as environment variables.
# The business app (Start free and Sign in buttons).
REACT_APP_APP_URL=https://app.threade.app
# Waitlist: the Supabase project URL and the anon (public) key. Never the service role key.
# Empty: the waitlist form asks people to email team@threade.app instead.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
