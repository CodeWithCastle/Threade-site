# Copy to .env.local (not committed) and fill in; on Vercel set them as environment variables.
# The business app (Start free and Sign in buttons).
REACT_APP_APP_URL=https://app.threade.app
# The waitlist's server function (api/waitlist.js) only. Never REACT_APP_: the pages hold no Supabase
# address or key. Locally the function runs with `vercel dev`; `npm start` serves the pages only.
THREADE_SUPABASE_URL=
THREADE_SUPABASE_PUBLISHABLE_KEY=
# At least 32 random characters; its SHA-256 is stored in the database (see README, Waitlist).
WAITLIST_PROXY_SECRET=
# At least 16 random characters; keys the hash of visitors' IP addresses for the per-visitor limit.
WAITLIST_IP_SALT=
